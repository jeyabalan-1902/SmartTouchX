extern SPI_HandleTypeDef hspi2;
extern UART_HandleTypeDef huart2;
extern osMutexId_t gpioMutex;
static uint8_t _DeviceState = STATE_INIT;
static uint8_t PrevState = 0;
uint8_t EncryptionKey[] = { 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08,
		0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08};

void  RFM_Task(void)
{
	while(1)
	{
		RF69_ModuleHandler();
		vTaskDelay(pdMS_TO_TICKS(10));
	}
}

void RF69_ModuleHandler(void)
{

	if(_DeviceState == STATE_INIT)
	{
		PrevState = STATE_INIT;
		if(RF69_init() == true)
		{
			_DeviceState = SET_FREQ;
			printf("RF69_InitSuccess\n");
		}
		else
			_DeviceState = FAIL_STATE;
	}
	else if(_DeviceState == SET_FREQ)
	{
		PrevState =	SET_FREQ;
		if(setFrequency(RF69_FREQ) == true)
		{
			_DeviceState = SET_POW;
			printf("RF69_FreqSetSuccess\n");
		}
		else
			_DeviceState = FAIL_STATE;
	}
	else if(_DeviceState == SET_POW)
	{
		PrevState = SET_POW;
		setTxPower(20, true);
		_DeviceState = SET_ENCKEY;
		printf("RF69_PowerSetSuccess\n");
	}
	else if(_DeviceState == SET_ENCKEY)
	{
		PrevState = SET_ENCKEY;
		setEncryptionKey(&EncryptionKey[0]);
		_DeviceState = RX_DATA;
		printf("RF69_setEncryptionKeySuccess\n");
	}
	else if(_DeviceState == TX_DATA)
	{
		PrevState = TX_DATA;
	}
	else if(_DeviceState == RX_DATA)
	{
		PrevState = RX_DATA;

		if(RF69_RxData() != true)
			_DeviceState = SYS_RESTART;
	}
	else if(_DeviceState == FAIL_STATE)
	{
		if(FailIndiCation(PrevState) == true)
		{
			printf("Module Going To Restart\n");
			HAL_Delay(3000);
			_DeviceState = SYS_RESTART;
		}
	}
	else if(_DeviceState == SYS_RESTART)
	{
		_DeviceState = STATE_INIT;
		printf("SYS_Restarted\n");
	}
	else if(_DeviceState == SYS_REST)
	{
		_DeviceState = SYS_SLEEP;
	}
	else if(_DeviceState == SYS_SLEEP)
	{
		setSleep();
		HAL_SPI_DeInit(&hspi2);
		HAL_UART_DeInit(&huart2);
		HAL_SuspendTick();
		HAL_PWR_EnterSLEEPMode(PWR_LOWPOWERREGULATOR_ON,PWR_SLEEPENTRY_WFI);
		_DeviceState = RX_DATA;
	}
}

bool RF69_TxData(void)
{
	return true; //Never Reach Here
}

bool RF69_RxData(void)
{
//	printf("RF69 StartReceiving\n");
//	HAL_PWR_EnterSLEEPMode(PWR_MAINREGULATOR_ON, PWR_SLEEPENTRY_WFI);

	if (available())
	{

		uint8_t buf[RH_RF69_MAX_MESSAGE_LEN];
		uint8_t len = sizeof(buf);
		printf("Data Available..\r\n");
		if (recv1(buf, &len))
		{
			if (!len)
			{
				buf[len] = 0;
			}

			printf("ReceivedData [%d]:%s\n", len, (char*)buf);
			printf("RSSI: %d\n", lastRssi());
			HAL_GPIO_WritePin(LED_RED_GPIO_Port, LED_RED_Pin, 1);
			HAL_Delay(100);
			HAL_GPIO_WritePin(LED_RED_GPIO_Port, LED_RED_Pin, 0);

			if (strstr((char *)buf, "Control#1"))
			{
				if(osMutexAcquire(gpioMutex, osWaitForever) == osOK)
				{
					GPIO_PinState gpioState = HAL_GPIO_ReadPin(RELAY1_GPIO_Port, RELAY1_Pin);
					uint8_t state = (gpioState == GPIO_PIN_SET) ? 1 : 0;
					if(state)
					{
						HAL_GPIO_WritePin(RELAY1_GPIO_Port, RELAY1_Pin, GPIO_PIN_RESET);
						printf("Relay1 OFF\n\r");
					}
					else
					{
						HAL_GPIO_WritePin(RELAY1_GPIO_Port, RELAY1_Pin, GPIO_PIN_SET);
						printf("Relay1 ON\n\r");
					}
					osMutexRelease(gpioMutex);
				}
			}
			else if(strstr((char *)buf, "Control#0"))
			{
				if(osMutexAcquire(gpioMutex, osWaitForever) == osOK)
				{
					GPIO_PinState gpioState = HAL_GPIO_ReadPin(RELAY2_GPIO_Port, RELAY2_Pin);
					uint8_t state = (gpioState == GPIO_PIN_SET) ? 1 : 0;
					if(state)
					{
						HAL_GPIO_WritePin(RELAY2_GPIO_Port, RELAY2_Pin, GPIO_PIN_RESET);
						printf("Relay2 OFF\n\r");
					}
					else
					{
						HAL_GPIO_WritePin(RELAY2_GPIO_Port, RELAY2_Pin, GPIO_PIN_SET);
						printf("Relay2 ON\n\r");
					}
					osMutexRelease(gpioMutex);
				}
			}
		}
		else
		{
			HAL_GPIO_WritePin(LED_RED_GPIO_Port, LED_RED_Pin, 0);
			printf("Receive failed\n");
		}
	}
	return true;
}

bool FailIndiCation(Rf69_t FailState)
{
	if(FailState == STATE_INIT)
		printf("ModuleInit_Failed\n");
	else if(FailState == SET_FREQ)
		printf("FreqSetOp_Failed\n");
	else if(FailState == SET_POW)
		printf("PowerSetOp_Failed\n");
	else if(FailState == SET_ENCKEY)
		printf("EncKeySetOp_Failed\n");
	else if(FailState == TX_DATA)
		printf("DataTxOp_Failed\n");
	else if(FailState == RX_DATA)
		printf("DataRxOp_Failed\n");

	return true;
}
