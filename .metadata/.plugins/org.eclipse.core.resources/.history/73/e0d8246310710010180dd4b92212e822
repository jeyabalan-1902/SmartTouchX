FATFS fs;
FIL fil;
FRESULT fres;
UINT br, bw;
void test_sd_card(void)
{
    if (f_mount(&fs, "", 1) == FR_OK)
    {
        printf("SD Card mounted successfully.\r\n");

        fres = f_open(&fil, "abrar.txt", FA_OPEN_ALWAYS | FA_WRITE);
        if (fres == FR_OK)
        {
            f_lseek(&fil, f_size(&fil));

            if (f_size(&fil) == 0)
            {
                char header[512];
                sprintf(header,
                        "+------+--------+-------------+-------------+-------------+------------+----------------+\r\n"
                        "| STEP | BLOCK  |  WEIGHT(g)  | START TIME  |  END TIME   | DURATION   | THREAD STATUS  |\r\n"
                        "+------+--------+-------------+-------------+-------------+------------+----------------+\r\n");
                f_write(&fil, header, strlen(header), &bw);
            }

            const char *blocks[] = {"A", "B", "C", "D", "E", "F"};
            const char *start_times[][3] = {
                {"09:06:00", "09:06:38", "09:07:17"},
                {"09:06:00", "09:06:36", "09:07:06"},
                {"09:06:00", "09:06:32", "09:07:14"},
                {"09:06:00", "09:06:39", "09:07:14"},
                {"09:06:00", "09:06:43", "09:07:12"},
                {"09:06:00", "09:06:35", "09:07:13"}
            };
            const char *end_times[][3] = {
                {"09:06:38", "09:07:17", "09:08:01"},
                {"09:06:36", "09:07:06", "09:07:42"},
                {"09:06:32", "09:07:14", "09:07:45"},
                {"09:06:39", "09:07:14", "09:07:47"},
                {"09:06:43", "09:07:12", "09:07:46"},
                {"09:06:35", "09:07:13", "09:07:48"}
            };
            const char *durations[][3] = {
                {"0:00:38", "0:00:39", "0:00:44"},
                {"0:00:36", "0:00:30", "0:00:36"},
                {"0:00:32", "0:00:42", "0:00:31"},
                {"0:00:39", "0:00:35", "0:00:33"},
                {"0:00:43", "0:00:29", "0:00:34"},
                {"0:00:35", "0:00:38", "0:00:35"}
            };
            float weights[][3] = {
                {150.237, 0.806, 0.296},
                {150.122, 0.805, 0.284},
                {150.281, 0.758, 0.262},
                {150.274, 0.792, 0.291},
                {150.287, 0.805, 0.252},
                {150.208, 0.785, 0.285}
            };

            for (int block = 0; block < 6; block++)
            {

                for (int step = 0; step < 3; step++)
                {
                    char line[300];
                    sprintf(line,
                    		"| %-4s | %-6s | %11.3f | %-11s | %-11s | %-10s | %-14s |\r\n",
                            step == 0 ? "0" : "",  // show step only for first row
                            blocks[block],
                            weights[block][step],
                            start_times[block][step],
                            end_times[block][step],
                            durations[block][step],
                            (step == 0) ? "OK" : "");
                    f_write(&fil, line, strlen(line), &bw);
                    HAL_UART_Transmit(&huart2, (uint8_t*)line, strlen(line), HAL_MAX_DELAY);  // Send each line via UART

                }
            }

                char separator[] = "+------+--------+-------------+-------------+-------------+------------+----------------+\r\n";
                f_write(&fil, separator, strlen(separator), &bw);
                f_close(&fil);
                printf("Formatted table with lines written to abrar.txt\r\n");
        }
        else
        {
            printf("Failed to open file for writing.\r\n");
        }
    }
    else
    {
        printf("SD Card mount failed.\r\n");
    }

    f_mount(NULL, "", 1);
}

